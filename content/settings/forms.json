{
  "forms": [
    {
      "id": "booking",
      "name": "Бронювання готелю (демо)",
      "preset": "booking",
      "layout": "bar",
      "fields": [
        {
          "kind": "choice",
          "key": "destination",
          "icon": "mdi-map-marker-outline",
          "required": true,
          "label": {
            "uk": "Куди",
            "en": "Where to",
            "de": "Wohin"
          },
          "placeholder": {
            "uk": "Оберіть місто",
            "en": "Choose a city",
            "de": "Stadt wählen"
          },
          "request": "hotel-destinations"
        },
        {
          "kind": "dates",
          "key": "dates",
          "icon": "mdi-calendar-range",
          "required": true,
          "range": true,
          "label": {
            "uk": "Заїзд — виїзд",
            "en": "Check-in — check-out",
            "de": "Anreise — Abreise"
          },
          "units": {
            "uk": "ніч|ночі|ночей",
            "en": "night|nights",
            "de": "Nacht|Nächte"
          },
          "request": "hotel-availability"
        },
        {
          "kind": "counters",
          "key": "guests",
          "icon": "mdi-account-multiple-outline",
          "label": {
            "uk": "Гості",
            "en": "Guests",
            "de": "Gäste"
          },
          "items": [
            {
              "key": "adults",
              "label": {
                "uk": "Дорослі",
                "en": "Adults",
                "de": "Erwachsene"
              },
              "min": 1,
              "max": 12,
              "start": 2,
              "units": {
                "uk": "дорослий|дорослі|дорослих",
                "en": "adult|adults",
                "de": "Erwachsener|Erwachsene"
              }
            },
            {
              "key": "children",
              "label": {
                "uk": "Діти",
                "en": "Children",
                "de": "Kinder"
              },
              "min": 0,
              "max": 8,
              "start": 0,
              "units": {
                "uk": "дитина|дитини|дітей",
                "en": "child|children",
                "de": "Kind|Kinder"
              }
            },
            {
              "key": "rooms",
              "label": {
                "uk": "Номери",
                "en": "Rooms",
                "de": "Zimmer"
              },
              "min": 1,
              "max": 6,
              "start": 1,
              "units": {
                "uk": "номер|номери|номерів",
                "en": "room|rooms",
                "de": "Zimmer|Zimmer"
              }
            }
          ]
        },
        {
          "kind": "cards",
          "key": "room",
          "icon": "mdi-bed-outline",
          "label": {
            "uk": "Оберіть номер",
            "en": "Choose a room",
            "de": "Zimmer wählen"
          },
          "suffix": {
            "uk": "за ніч",
            "en": "a night",
            "de": "pro Nacht"
          },
          "empty": {
            "uk": "На ці дати для такої кількості гостей вільних номерів немає. Спробуйте інші дати.",
            "en": "No rooms are free for these dates and guests. Try other dates.",
            "de": "Für diese Daten und Gäste sind keine Zimmer frei. Versuchen Sie andere Daten."
          },
          "request": "hotel-rooms"
        }
      ],
      "button": {
        "label": {
          "uk": "Знайти",
          "en": "Search",
          "de": "Suchen"
        },
        "request": "hotel-booking"
      }
    },
    {
      "id": "client-form",
      "name": "Своя форма",
      "layout": "stack",
      "fields": [
        {
          "key": "field-1",
          "label": {
            "uk": "Ваше імʼя",
            "en": "Your name",
            "de": "Ihr Name"
          },
          "required": true,
          "kind": "text",
          "icon": "mdi-form-textbox",
          "input": "text"
        },
        {
          "key": "field-2",
          "label": {
            "uk": "Телефон",
            "en": "Phone",
            "de": "Telefon"
          },
          "required": true,
          "kind": "text",
          "icon": "mdi-phone-outline",
          "input": "tel"
        },
        {
          "key": "field-3",
          "label": {
            "uk": "Коментар",
            "en": "Comment",
            "de": "Kommentar"
          },
          "kind": "text",
          "icon": "mdi-message-text-outline",
          "input": "textarea"
        }
      ],
      "button": {
        "label": {
          "uk": "Надіслати",
          "en": "Send",
          "de": "Senden"
        },
        "action": "channel",
        "done": {
          "uk": "Дякуємо! Повідомлення надіслано — відповімо найближчим часом.",
          "en": "Thank you! Your message has been sent — we’ll get back to you soon.",
          "de": "Danke! Ihre Nachricht wurde gesendet – wir melden uns in Kürze."
        }
      }
    },
    {
      "id": "order",
      "name": "Оформлення замовлення",
      "layout": "stack",
      "fields": [
        {
          "key": "field-1",
          "label": {
            "uk": "Хто укладає договір",
            "en": "Who signs the contract",
            "de": "Wer schließt den Vertrag"
          },
          "required": true,
          "kind": "choice",
          "icon": "mdi-format-list-bulleted",
          "options": [
            {
              "value": "fop",
              "label": {
                "uk": "ФОП",
                "en": "Sole proprietor",
                "de": "Einzelunternehmer"
              }
            },
            {
              "value": "company",
              "label": {
                "uk": "Компанія (ТОВ)",
                "en": "Company (LLC)",
                "de": "Unternehmen (GmbH)"
              }
            },
            {
              "value": "person",
              "label": {
                "uk": "Фізична особа",
                "en": "Private person",
                "de": "Privatperson"
              }
            }
          ]
        },
        {
          "key": "field-2",
          "label": {
            "uk": "Назва компанії або ПІБ",
            "en": "Company name or full name",
            "de": "Firmenname oder vollständiger Name"
          },
          "required": true,
          "kind": "text",
          "icon": "mdi-form-textbox",
          "input": "text"
        },
        {
          "key": "field-3",
          "label": {
            "uk": "Код ЄДРПОУ (для компанії)",
            "en": "Company registration number",
            "de": "Handelsregisternummer (für Unternehmen)"
          },
          "kind": "text",
          "icon": "mdi-form-textbox",
          "input": "text"
        },
        {
          "key": "field-4",
          "label": {
            "uk": "Юридична адреса",
            "en": "Registered address",
            "de": "Anschrift"
          },
          "required": true,
          "kind": "text",
          "icon": "mdi-form-textbox",
          "input": "text"
        },
        {
          "key": "field-5",
          "label": {
            "uk": "Email для договору й рахунку",
            "en": "Email for the contract and invoice",
            "de": "E-Mail für Vertrag und Rechnung"
          },
          "required": true,
          "kind": "text",
          "icon": "mdi-email-outline",
          "input": "email"
        },
        {
          "key": "field-6",
          "label": {
            "uk": "Телефон",
            "en": "Phone",
            "de": "Telefon"
          },
          "required": true,
          "kind": "text",
          "icon": "mdi-phone-outline",
          "input": "tel"
        },
        {
          "key": "field-7",
          "label": {
            "uk": "Додати «Без згадки про Pagewright»",
            "en": "Add \"No Pagewright mention\"",
            "de": "„Ohne Pagewright-Hinweis“ hinzufügen"
          },
          "kind": "check"
        },
        {
          "key": "field-8",
          "label": {
            "uk": "Коментар",
            "en": "Comment",
            "de": "Kommentar"
          },
          "kind": "text",
          "icon": "mdi-message-text-outline",
          "input": "textarea"
        }
      ],
      "button": {
        "label": {
          "uk": "Надіслати заявку",
          "en": "Send the request",
          "de": "Anfrage senden"
        },
        "action": "channel",
        "done": {
          "uk": "Дякуємо! Повідомлення надіслано — відповімо найближчим часом.",
          "en": "Thank you! Your message has been sent — we’ll get back to you soon.",
          "de": "Danke! Ihre Nachricht wurde gesendet – wir melden uns in Kürze."
        }
      }
    }
  ]
}
