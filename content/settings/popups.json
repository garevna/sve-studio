        "de": "Möchten Sie das ausgewählte Element wirklich löschen?"
      },
      "okText": {
        "uk": "Підтвердити",
        "en": "Confirm",
        "de": "Bestätigen"
      },
      "cancelText": {
        "uk": "Скасувати",
        "en": "Cancel",
        "de": "Abbrechen"
      }
