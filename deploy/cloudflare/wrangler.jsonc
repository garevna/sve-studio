// Pagewright on Cloudflare (pagewright.pp.ua) - deployed by
// .github/workflows/deploy.yml after `pnpm generate` (root "/").
{
  "name": "pagewright",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": "../../.output/public",
    "binding": "ASSETS",
    // Addresses with no file go to worker.js (the apps' start pages).
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "pagewright.pp.ua", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
