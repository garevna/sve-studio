erDiagram
  PAGE ||--o{ BLOCK : "blocks"
  BLOCK ||--o{ BLOCK : "children, Button der Karte"
  MENU }o--|| PAGE : "pageId"
  BLOCK }o--o| POPUP : "popup (id)"
  BLOCK }o--o| SET_BUTTON : "class (Klassenname)"
  POPUPS ||--o{ POPUP : "popups"
  POPUPS ||--o{ LOOK : "looks"
  POPUPS ||--o{ CALENDAR : "calendars"
  POPUP }o--|| LOOK : "look (id)"
  POPUP }o--o| CALENDAR : "calendar (id)"
  POPUP ||--o{ BLOCK : "content: Blöcke, Formularfelder"
  POPUP }o--o| REQUEST : "deliver (id)"
  BLOCK }o--o| REQUEST : "destinations, availability, booking"
  LOOK }o--o{ SET_BUTTON : "buttons.main, .second"
  CLIENT_API ||--o{ REQUEST : "requests"
  FORMS ||--o{ FORM : "forms"
  BLOCK }o--o| FORM : "form (id)"
  FORM }o--o{ REQUEST : "request der Felder und Schaltfläche"
  FORM }o--o| GLOBAL : "action channel"
  POPUPS ||--o{ FIELD_LOOK : "fieldLooks"
  FORM }o--o| FIELD_LOOK : "look (id)"

  PAGE {
    string id PK "pages/*.json"
    json title "Name in allen Sprachen"
    bool visible
  }
  BLOCK {
    string type "header, cards, tabs, button, form-field..."
    string class "Format und Abstand, mb-N"
    string action "Popup oder Link"
    string popup FK
    json popupContext "worum es geöffnet wurde"
  }
  MENU {
    json items "menu-content.json"
  }
  POPUPS {
    string file "settings/popups.json"
  }
  POPUP {
    string id PK
    string kind "message, confirm, prompt, select, date, form..."
    string look FK
    string calendar FK
    string deliver FK
  }
  LOOK {
    string id PK
    string base "centered, classic, header"
    string titleClass
    string textClass
  }
  CALENDAR {
    string id PK
    string variant "simple, extended"
  }
  SET_BUTTON {
    string className PK "styles/button-set.css"
    string name "Name, den der Kunde vergab"
    string template "Art aus dem Katalog"
  }
  GLOBAL {
    string file "settings/global.json"
    string feedbackEndpoint "wohin Formulare gehen"
  }
  CLIENT_API {
    string file "settings/client-api.json"
    string baseUrl "Basis relativer Adressen"
  }
  REQUEST {
    string id PK
    string role "options, dates, handoff, answer"
    string mode "link oder session"
  }
  FORMS {
    string file "settings/forms.json"
  }
  FORM {
    string id PK
    string name "Name im Editor"
    string layout "bar oder stack"
    json fields "choice, dates, counters, cards, text"
    string action "channel oder api"
  }
  FIELD_LOOK {
    string id PK
    json closed "geschlossene und geöffnete Ansicht"
  }
