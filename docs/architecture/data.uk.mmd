erDiagram
  PAGE ||--o{ BLOCK : "blocks"
  BLOCK ||--o{ BLOCK : "children, button картки"
  MENU }o--|| PAGE : "pageId"
  BLOCK }o--o| POPUP : "popup (id)"
  BLOCK }o--o| SET_BUTTON : "class (назва класу)"
  POPUPS ||--o{ POPUP : "popups"
  POPUPS ||--o{ LOOK : "looks"
  POPUPS ||--o{ CALENDAR : "calendars"
  POPUP }o--|| LOOK : "look (id)"
  POPUP }o--o| CALENDAR : "calendar (id)"
  POPUP ||--o{ BLOCK : "content: блоки, поля форми"
  POPUP }o--o| REQUEST : "deliver (id)"
  BLOCK }o--o| REQUEST : "destinations, availability, booking"
  LOOK }o--o{ SET_BUTTON : "buttons.main, .second"
  CLIENT_API ||--o{ REQUEST : "requests"
  FORMS ||--o{ FORM : "forms"
  BLOCK }o--o| FORM : "form (id)"
  FORM }o--o{ REQUEST : "request полів і кнопки"
  FORM }o--o| GLOBAL : "action channel"
  POPUPS ||--o{ FIELD_LOOK : "fieldLooks"
  FORM }o--o| FIELD_LOOK : "look (id)"

  PAGE {
    string id PK "pages/*.json"
    json title "назва всіма мовами"
    bool visible
  }
  BLOCK {
    string type "header, cards, tabs, button, form-field..."
    string class "формат і відступ, mb-N"
    string action "popup або перехід"
    string popup FK
    json popupContext "про що відкрито"
  }
  MENU {
    json items "menu-content.json"
  }
  POPUPS {
    string file "settings/popups.json"
  }
  POPUP {
    string id PK
    string kind "message, confirm, prompt, select, date, form..."
    string look FK
    string calendar FK
    string deliver FK
  }
  LOOK {
    string id PK
    string base "centered, classic, header"
    string titleClass
    string textClass
  }
  CALENDAR {
    string id PK
    string variant "simple, extended"
  }
  SET_BUTTON {
    string className PK "styles/button-set.css"
    string name "ім'я, яке дав клієнт"
    string template "вид із каталогу"
  }
  GLOBAL {
    string file "settings/global.json"
    string feedbackEndpoint "куди йдуть форми"
  }
  CLIENT_API {
    string file "settings/client-api.json"
    string baseUrl "база відносних адрес"
  }
  REQUEST {
    string id PK
    string role "options, dates, handoff, answer"
    string mode "link або session"
  }
  FORMS {
    string file "settings/forms.json"
  }
  FORM {
    string id PK
    string name "назва в редакторі"
    string layout "bar або stack"
    json fields "choice, dates, counters, cards, text"
    string action "channel або api"
  }
  FIELD_LOOK {
    string id PK
    json closed "закритий і розгорнутий вигляд"
  }
